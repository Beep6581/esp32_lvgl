+        bool has_dpp_akm = false;
+        for (size_t i = 0; i < s_dpp_ctx.dpp_auth->num_conf_obj; i++) {
+            if (dpp_akm_dpp(s_dpp_ctx.dpp_auth->conf_obj[i].akm)) {
+                has_dpp_akm = true;
+                break;
+            }
+        }
+
+        if (!has_dpp_akm) {
+            dpp_stop_internal();
+        } else {
+            dpp_cancel_auth_gas_eloop_timeouts();
+        }
+    }
