+struct wpabuf * dpp_build_conf_result(struct dpp_authentication *auth,
+				      enum dpp_status_error status)
+{
+	struct wpabuf *msg, *clear;
+	size_t nonce_len = auth->curve->nonce_len;
+	size_t clear_len = 5 + 4 + nonce_len;
+	const u8 *addr[2];
+	size_t len[2];
+	u8 *wrapped;
+
+	clear = wpabuf_alloc(clear_len);
+	msg = dpp_alloc_msg(DPP_PA_CONFIGURATION_RESULT,
+			    4 + clear_len + AES_BLOCK_SIZE);
+	if (!clear || !msg)
+		goto fail;
+
+	/* DPP Status and the authenticated session's Enrollee Nonce. */
+	dpp_build_attr_status(clear, status);
+	wpabuf_put_le16(clear, DPP_ATTR_ENROLLEE_NONCE);
+	wpabuf_put_le16(clear, nonce_len);
+	wpabuf_put_data(clear, auth->e_nonce, nonce_len);
+
+	/* Authenticate the DPP header and the empty preceding attribute set. */
+	addr[0] = wpabuf_head_u8(msg) + 2;
+	len[0] = DPP_HDR_LEN;
+	addr[1] = wpabuf_put(msg, 0);
+	len[1] = 0;
+	wpabuf_put_le16(msg, DPP_ATTR_WRAPPED_DATA);
+	wpabuf_put_le16(msg, clear_len + AES_BLOCK_SIZE);
+	wrapped = wpabuf_put(msg, clear_len + AES_BLOCK_SIZE);
+	if (aes_siv_encrypt(auth->ke, auth->curve->hash_len,
+			    wpabuf_head(clear), wpabuf_len(clear),
+			    2, addr, len, wrapped) < 0)
+		goto fail;
+
+	wpabuf_clear_free(clear);
+	return msg;
+fail:
+	wpabuf_clear_free(clear);
+	wpabuf_free(msg);
+	return NULL;
+}
