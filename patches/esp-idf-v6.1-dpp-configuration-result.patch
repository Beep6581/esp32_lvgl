+static void esp_dpp_finish_config(void)
+{
+    /* Keep auth and the validated event alive until Configuration Result TX. */
+    if (s_dpp_ctx.config_event) {
+        return;
+    }
+
+    /* Legacy credentials need no auth state after delivery; DPP AKM still
+     * needs it for network introduction. Preserve the existing cleanup policy. */
