+struct wpabuf * dpp_build_conn_status_result(struct dpp_authentication *auth,
+					   enum dpp_status_error result,
+					   const u8 *ssid, size_t ssid_len,
+					   const char *channel_list)
+{
+	struct wpabuf *json = NULL, *clear = NULL, *msg = NULL;
+	const u8 *addr[2];
+	size_t len[2], clear_len;
+	u8 *wrapped;
+
+	if (ssid_len > 32)
+		return NULL;
+	json = wpabuf_alloc(128 + (channel_list ? os_strlen(channel_list) : 0));
+	if (!json)
+		goto fail;
+	json_start_object(json, NULL);
+	json_add_int(json, "result", result);
+	json_value_sep(json);
+	if (json_add_base64url(json, "ssid64", ssid, ssid_len) < 0)
+		goto fail;
+	if (channel_list) {
+		json_value_sep(json);
+		json_add_string(json, "channelList", channel_list);
+	}
+	json_end_object(json);
+
+	clear_len = 4 + auth->curve->nonce_len + 4 + wpabuf_len(json);
+	clear = wpabuf_alloc(clear_len);
+	msg = dpp_alloc_msg(DPP_PA_CONNECTION_STATUS_RESULT,
+			    4 + clear_len + AES_BLOCK_SIZE);
+	if (!clear || !msg)
+		goto fail;
+	wpabuf_put_le16(clear, DPP_ATTR_ENROLLEE_NONCE);
+	wpabuf_put_le16(clear, auth->curve->nonce_len);
+	wpabuf_put_data(clear, auth->e_nonce, auth->curve->nonce_len);
+	wpabuf_put_le16(clear, DPP_ATTR_CONN_STATUS);
+	wpabuf_put_le16(clear, wpabuf_len(json));
+	wpabuf_put_buf(clear, json);
+
+	addr[0] = wpabuf_head_u8(msg) + 2;
+	len[0] = DPP_HDR_LEN;
+	addr[1] = wpabuf_put(msg, 0);
+	len[1] = 0;
+	wpabuf_put_le16(msg, DPP_ATTR_WRAPPED_DATA);
+	wpabuf_put_le16(msg, clear_len + AES_BLOCK_SIZE);
+	wrapped = wpabuf_put(msg, clear_len + AES_BLOCK_SIZE);
+	if (aes_siv_encrypt(auth->ke, auth->curve->hash_len,
+			    wpabuf_head(clear), wpabuf_len(clear),
+			    2, addr, len, wrapped) < 0)
+		goto fail;
+	wpabuf_free(json);
+	wpabuf_clear_free(clear);
+	return msg;
+fail:
+	wpabuf_free(json);
+	wpabuf_clear_free(clear);
+	wpabuf_free(msg);
+	return NULL;
+}
