+esp_err_t esp_supp_dpp_report_connection_status(void)
+{
+    if (dpp_api_lock() != ESP_OK) {
+        return ESP_ERR_INVALID_STATE;
+    }
+    struct dpp_authentication *auth = s_dpp_ctx.dpp_auth;
+    if (!auth || !auth->conn_status_requested) {
+        dpp_api_unlock();
+        return ESP_OK;
+    }
+    if (s_dpp_ctx.dpp_deinit_pending || s_dpp_ctx.config_event ||
+            s_dpp_ctx.pending_tx_op_in_progress) {
+        dpp_api_unlock();
+        return ESP_ERR_INVALID_STATE;
+    }
+
+    /* Do not report success for a previous network restored after failure. */
+    wifi_ap_record_t ap;
+    bool matches = false;
+    if (esp_wifi_sta_get_ap_info(&ap) == ESP_OK) {
+        size_t ssid_len = os_strlen((const char *)ap.ssid);
+        for (size_t i = 0; i < auth->num_conf_obj; i++) {
+            if (ssid_len == auth->conf_obj[i].ssid_len &&
+                    os_memcmp(ap.ssid, auth->conf_obj[i].ssid, ssid_len) == 0) {
+                matches = true;
+                break;
+            }
+        }
+    }
+    if (!matches) {
+        dpp_api_unlock();
+        return ESP_ERR_INVALID_STATE;
+    }
+
+    struct wpabuf *msg = dpp_build_conn_status_result(auth, DPP_STATUS_OK,
+                            ap.ssid, os_strlen((const char *)ap.ssid), NULL);
+    if (!msg) {
+        dpp_api_unlock();
+        return ESP_ERR_NO_MEM;
+    }
+    os_event_group_clear_bits(s_dpp_event_group, DPP_CONN_STATUS_DONE | DPP_CONN_STATUS_OK);
+    /* The configurator listens on the original DPP channel, not the AP channel. */
+    esp_err_t ret = esp_dpp_send_action_frame(auth->peer_mac_addr,
+                        wpabuf_head(msg), wpabuf_len(msg), auth->curr_chan,
+                        OFFCHAN_TX_WAIT_TIME, DPP_TX_CONNECTION_STATUS_RESULT);
+    wpabuf_free(msg);
+    if (ret == ESP_OK) {
+        auth->conn_status_requested = 0;
+        wpa_printf(MSG_INFO, "DPP: Connection Status Result submitted on channel %u", auth->curr_chan);
+    }
+    dpp_api_unlock();
+    if (ret != ESP_OK) {
+        return ret;
+    }
+
+    /* The persistent event group outlives auth even if cancellation races TX.
+     * Never hold the DPP lock while waiting for the eloop TX-status handler. */
+    unsigned int bits = os_event_group_wait_bits(s_dpp_event_group,
+                            DPP_CONN_STATUS_DONE, 0, 0, os_task_ms_to_tick(2000));
+    if (!(bits & DPP_CONN_STATUS_DONE)) {
+        return ESP_ERR_TIMEOUT;
+    }
+    return bits & DPP_CONN_STATUS_OK ? ESP_OK : ESP_FAIL;
+}
