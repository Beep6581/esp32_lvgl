+/* Experimental v6.1 extension. Report successful association to an accepted
+ * DPP network if the configurator requested Connection Status. Call once from
+ * an application worker after GOT_IP, before stop_listen/deinit. Must not run
+ * on the default event loop or supplicant eloop: waits up to 2 s for TX status.
+ * ESP_OK also means no report was requested. ESP_ERR_INVALID_STATE means the
+ * current association does not match an accepted configuration; no success
+ * is transmitted. TX failure/timeout does not undo the Wi-Fi connection.
+ * Cancel/deinit still frees retained authentication state without a report.
+ */
+#define ESP_SUPP_DPP_HAS_CONNECTION_STATUS_REPORT 1
+esp_err_t esp_supp_dpp_report_connection_status(void);
+
 /**
   * @brief Install or clear DPP AKM connector material in the supplicant.
