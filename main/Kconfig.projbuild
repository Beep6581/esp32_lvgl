menu "Application"

choice APP_MODE
    prompt "Application mode"
    default APP_MODE_AIR_QUALITY

config APP_MODE_AIR_QUALITY
    bool "Air-quality monitor"

config APP_MODE_SCREEN_DIAGNOSTICS
    bool "Screen diagnostics"

config APP_MODE_CLOCK
    bool "Particle clock"
    select LV_FONT_MONTSERRAT_48

endchoice

endmenu
